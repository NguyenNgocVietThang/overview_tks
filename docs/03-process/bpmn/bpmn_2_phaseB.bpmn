<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"><bpmn:collaboration id="Collaboration_1"><bpmn:participant id="Participant_1" name="Hệ thống Dashboard nội bộ (Google Sheets)" processRef="Process_PhaseB"/></bpmn:collaboration><bpmn:process id="Process_PhaseB" name="Giai đoạn B - Sử dụng Dashboard hằng ngày &amp; xuất báo cáo" isExecutable="false"><bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_admin" name="Admin"><bpmn:flowNodeRef>t_admin_menu</bpmn:flowNodeRef><bpmn:flowNodeRef>t_admin_manage_users</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_end_admin</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_nv" name="Nhân viên / Admin (Người dùng)"><bpmn:flowNodeRef>ev_start</bpmn:flowNodeRef><bpmn:flowNodeRef>t_select_dashboard</bpmn:flowNodeRef><bpmn:flowNodeRef>t_select_time</bpmn:flowNodeRef><bpmn:flowNodeRef>t_view</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_refresh</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_export</bpmn:flowNodeRef><bpmn:flowNodeRef>t_choose_export</bpmn:flowNodeRef><bpmn:flowNodeRef>t_download</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_end_export</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_end_session</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_sys" name="Hệ thống (Backend)"><bpmn:flowNodeRef>gw_role</bpmn:flowNodeRef><bpmn:flowNodeRef>t_calc_kpi</bpmn:flowNodeRef><bpmn:flowNodeRef>t_call_api</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_refresh_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>t_refresh_error</bpmn:flowNodeRef><bpmn:flowNodeRef>t_update_timestamp</bpmn:flowNodeRef><bpmn:flowNodeRef>t_package</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_sheet" name="Google Sheets / Apps Script"><bpmn:flowNodeRef>t_sheets_return</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="ev_start" name="Người dùng đăng nhập (FR-01.1)"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:exclusiveGateway id="gw_role" name="Vai trò người dùng?"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_admin_menu" name="Thấy thêm menu Quản lý người dùng (FR-06.3)"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task><bpmn:task id="t_admin_manage_users" name="Thêm/khóa/đổi vai trò tài khoản (FR-10.1)"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task><bpmn:endEvent id="ev_end_admin" name="Cập nhật danh sách người dùng"><bpmn:incoming>Flow_4</bpmn:incoming></bpmn:endEvent><bpmn:task id="t_select_dashboard" name="Chọn dashboard/view từ Sidebar (FR-06.1)"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task><bpmn:task id="t_select_time" name="Chọn khung thời gian: 1/7/30/90 ngày (FR-07.1)"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task><bpmn:task id="t_calc_kpi" name="Tính lại KPI &amp; biểu đồ theo khung thời gian, không tải lại trang (FR-07.2)"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task><bpmn:task id="t_view" name="Xem KPI cards &amp; biểu đồ, có thể đổi loại biểu đồ (FR-05.2)"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_refresh" name="Bấm &quot;Làm mới&quot;?"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_call_api" name="Gọi lại Google Sheets API lấy dữ liệu mới (FR-08.1)"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task><bpmn:task id="t_sheets_return" name="Trả về dữ liệu Sheet mới nhất"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_refresh_ok" name="Làm mới thành công?"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_refresh_error" name="Hiển thị thông báo lỗi làm mới (FR-08.3)"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task><bpmn:task id="t_update_timestamp" name="Cập nhật timestamp lần cập nhật gần nhất (FR-08.2)"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_export" name="Muốn xuất báo cáo?"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_choose_export" name="Chọn xuất PDF và/hoặc Excel (FR-09.1, FR-09.2)"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:task><bpmn:task id="t_package" name="Đóng gói đúng dữ liệu &amp; khung thời gian đang hiển thị (FR-09.3)"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:task><bpmn:task id="t_download" name="Tải file xuống"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:task><bpmn:endEvent id="ev_end_export" name="Hoàn tất xuất báo cáo"><bpmn:incoming>Flow_21</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="ev_end_session" name="Kết thúc phiên xem"><bpmn:incoming>Flow_22</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="ev_start" targetRef="gw_role" /><bpmn:sequenceFlow id="Flow_2" sourceRef="gw_role" targetRef="t_admin_menu" name="Admin" /><bpmn:sequenceFlow id="Flow_3" sourceRef="t_admin_menu" targetRef="t_admin_manage_users" /><bpmn:sequenceFlow id="Flow_4" sourceRef="t_admin_manage_users" targetRef="ev_end_admin" /><bpmn:sequenceFlow id="Flow_5" sourceRef="gw_role" targetRef="t_select_dashboard" name="Nhân viên" /><bpmn:seque