<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"><bpmn:collaboration id="Collaboration_1"><bpmn:participant id="Participant_1" name="Hệ thống Dashboard nội bộ (Google Sheets)" processRef="Process_PhaseC"/></bpmn:collaboration><bpmn:process id="Process_PhaseC" name="Giai đoạn C - Đồng bộ tự động qua Webhook" isExecutable="false"><bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_admin" name="Admin"><bpmn:flowNodeRef>t_alert_admin</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_end_fail</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_nv" name="Nhân viên / Admin (Người dùng)"><bpmn:flowNodeRef>t_client_update</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_end</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_sys" name="Hệ thống (Backend)"><bpmn:flowNodeRef>gw_webhook_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>t_fallback</bpmn:flowNodeRef><bpmn:flowNodeRef>t_update_cache</bpmn:flowNodeRef><bpmn:flowNodeRef>t_push_ws</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_sheet" name="Google Sheets / Apps Script"><bpmn:flowNodeRef>ev_start</bpmn:flowNodeRef><bpmn:flowNodeRef>t_trigger</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="ev_start" name="Sheet nguồn thay đổi (onEdit/onChange)"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t_trigger" name="Apps Script trigger gọi Webhook endpoint (FR-08.4)"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_webhook_ok" name="Webhook xử lý thành công?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_fallback" name="Rơi về cơ chế làm mới thủ công (FR-08.6)"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task><bpmn:task id="t_alert_admin" name="Cảnh báo Admin qua giao diện"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:endEvent id="ev_end_fail" name="Kết thúc — chờ Admin xử lý"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent><bpmn:task id="t_update_cache" name="Đọc lại dữ liệu, cập nhật cache Redis (FR-08.4)"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task><bpmn:task id="t_push_ws" name="Đẩy cập nhật qua WebSocket/SSE tới client đang mở (FR-08.5)"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task><bpmn:task id="t_client_update" name="Giao diện tự cập nhật KPI/biểu đồ near real-time"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task><bpmn:endEvent id="ev_end" name="Đồng bộ hoàn tất (độ trễ mục tiêu &lt; 10 giây, NFR-09)"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="ev_start" targetRef="t_trigger" /><bpmn:sequenceFlow id="Flow_2" sourceRef="t_trigger" targetRef="gw_webhook_ok" /><bpmn:sequenceFlow id="Flow_3" sourceRef="gw_webhook_ok" targetRef="t_fallback" name="Thất bại / mất quyền" /><bpmn:sequenceFlow id="Flow_4" sourceRef="t_fallback" targetRef="t_alert_admin" /><bpmn:sequenceFlow id="Flow_5" sourceRef="t_alert_admin" targetRef="ev_end_fail" /><bpmn:sequenceFlow id="Flow_6" sourceRef="gw_webhook_ok" targetRef="t_update_cache" name="Thành công" /><bpmn:sequenceFlow id="Flow_7" sourceRef="t_update_cache" targetRef="t_push_ws" /><bpmn:sequenceFlow id="Flow_8" sourceRef="t_push_ws" targetRef="t_client_update" /><bpmn:sequenceFlow id="Flow_9" sourceRef="t_client_update" targetRef="ev_end" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_1"><bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1"><bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true"><dc:Bounds x="188" y="100" width="1334" height=