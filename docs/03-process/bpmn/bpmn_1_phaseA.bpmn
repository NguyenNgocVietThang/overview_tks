<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"><bpmn:collaboration id="Collaboration_1"><bpmn:participant id="Participant_1" name="Hệ thống Dashboard nội bộ (Google Sheets)" processRef="Process_PhaseA"/></bpmn:collaboration><bpmn:process id="Process_PhaseA" name="Giai đoạn A - Kết nối &amp; nhận diện dữ liệu Google Sheets" isExecutable="false"><bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_admin" name="Admin"><bpmn:flowNodeRef>ev_start</bpmn:flowNodeRef><bpmn:flowNodeRef>t_input_link</bpmn:flowNodeRef><bpmn:flowNodeRef>t_choose_method</bpmn:flowNodeRef><bpmn:flowNodeRef>t_choose_tab</bpmn:flowNodeRef><bpmn:flowNodeRef>t_admin_review</bpmn:flowNodeRef><bpmn:flowNodeRef>t_setup_trigger</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_nv" name="Nhân viên / Admin (Người dùng)"></bpmn:lane><bpmn:lane id="Lane_sys" name="Hệ thống (Backend)"><bpmn:flowNodeRef>gw_method</bpmn:flowNodeRef><bpmn:flowNodeRef>t_system_oauth</bpmn:flowNodeRef><bpmn:flowNodeRef>t_system_apikey</bpmn:flowNodeRef><bpmn:flowNodeRef>t_check_access</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_valid</bpmn:flowNodeRef><bpmn:flowNodeRef>t_show_error</bpmn:flowNodeRef><bpmn:flowNodeRef>t_read_header</bpmn:flowNodeRef><bpmn:flowNodeRef>t_detect_date</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_date</bpmn:flowNodeRef><bpmn:flowNodeRef>t_hide_filter</bpmn:flowNodeRef><bpmn:flowNodeRef>t_detect_numeric</bpmn:flowNodeRef><bpmn:flowNodeRef>t_gen_kpi_chart</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_end</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_sheet" name="Google Sheets / Apps Script"><bpmn:flowNodeRef>t_oauth_consent</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="ev_start" name="Admin cần thiết lập Dashboard"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t_input_link" name="Nhập link Google Sheets nguồn (FR-02.1)"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:task id="t_choose_method" name="Chọn phương thức truy cập: OAuth hoặc Link công khai (FR-02.2)"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_method" name="Phương thức truy cập?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_oauth_consent" name="Người dùng cấp quyền OAuth trên Google"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:task id="t_system_oauth" name="Lưu access token (mã hoá, có TTL)"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task><bpmn:task id="t_system_apikey" name="Gọi Sheets API bằng API key / link công khai"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task><bpmn:task id="t_check_access" name="Kiểm tra hợp lệ &amp; quyền truy cập Sheet (FR-02.3)"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_valid" name="Link hợp lệ &amp; có quyền truy cập?"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_show_error" name="Hiển thị lỗi rõ ràng, yêu cầu nhập lại"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task><bpmn:task id="t_choose_tab" name="Chọn tab/sheet cụ thể nếu có nhiều tab (FR-02.4)"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task><bpmn:task id="t_read_header" name="Đọc header + dữ liệu mẫu, suy luận kiểu dữ liệu cột (FR-03.1)"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task><bpmn:task id="t_detect_date" name="Xác định cột ngày tháng làm trục thời gian (FR-03.2)"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_date" name="Có cột ngày tháng?"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_hide_filter" name="Ẩn bộ lọc thời gian, vẫn hiện KPI/biểu đồ tổng (FR-03.5)"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:task><bpmn:task id="t_detect_numeric" name="Xác định cột số (KPI) &amp; cột danh mục để group (FR-03.3, FR-03.4)"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:task><bpmn:task id="t_gen_kpi_chart" name="Tự sinh KPI cards &amp; gợi ý loại biểu đồ (FR-04.1, FR-05.1)"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:task><bpmn:task id="t_admin_review" name="Xem trước &amp; điều chỉnh KPI/biểu đồ (ẩn/hiện, sắp xếp) (FR-10.2)"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:task><bpmn:task id="t_setup_trigger" name="Thiết lập Apps Script trigger onEdit/onChange trên Sheet (FR-08.4)"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:task><bpmn:endEvent id="ev_end" name="Dashboard sẵn sàng sử dụng"><bpmn:incoming>Flow_22</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="ev_start" targetRef="t_input_link" /><bpmn:sequenceFlow id="Flow_2" sourceRef="t_input_link" targetRef="t_choose_method" /><bpmn:sequenceFlow id="Flow_3" sourceRef="t_choose_method" targetRef="gw_method" /><bpmn:sequenceFlow id="Flow_4" sourceRef="gw_method" targetRef="t_oauth_consent" name="OAuth" /><bpmn:sequenceFlow id="Flow_5" sourceRef="t_oauth_consent" targetRef="t_system_oauth" /><bpmn:sequenceFlow id="Flow_6" sourceRef="gw_method" targetRef="t_system_apikey" name="Link công khai" /><bpmn:sequenceFlow id="Flow_7" sourceRef="t_system_oauth" targetRef="t_check_access" /><bpmn:sequenceFlow id="Flow_8" sourceRef="t_system_apikey" targetRef="t_check_access" /><bpmn:sequenceFlow id="Flow_9" sourceRef="t_check_access" targetRef="gw_valid" /><bpmn:sequenceFlow id="Flow_10" sourceRef="gw_valid" targetRef="t_show_error" name="Không hợp lệ" /><bpmn:sequenceFlow id="Flow_11" sourceRef="t_show_error" targetRef="t_input_link" name="Nhập lại link" /><bpmn:sequenceFlow id="Flow_12" sourceRef="gw_valid" targetRef="t_choose_tab" name="Hợp lệ" /><bpmn:sequenceFlow id="Flow_13" sourceRef="t_choose_tab" targetRef="t_read_header" /><bpmn:sequenceFlow id="Flow_14" sourceRef="t_read_header" targetRef="t_detect_date" /><bpmn:sequenceFlow id="Flow_15" sourceRef="t_detect_date" targetRef="gw_date" /><bpmn:sequenceFlow id="Flow_16" sourceRef="gw_date" targetRef="t_hide_filter" name="Không" /><bpmn:sequenceFlow id="Flow_17" sourceRef="t_hide_filter" targetRef="t_detect_numeric" /><bpmn:sequenceFlow id="Flow_18" sourceRef="gw_date" targetRef="t_detect_numeric" name="Có" /><bpmn:sequenceFlow id="Flow_19" sourceRef="t_detect_numeric" targetRef="t_gen_kpi_chart" /><bpmn:sequenceFlow id="Flow_20" sourceRef="t_gen_kpi_chart" targetRef="t_admin_review" /><bpmn:sequenceFlow id="Flow_21" sourceRef="t_admin_review" targetRef="t_setup_trigger" /><bpmn:sequenceFlow id="Flow_22" sourceRef="t_setup_trigger" targetRef="ev_end" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_1"><bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1"><bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true"><dc:Bounds x="188" y="100" width="3234" height="870"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_admin_di" bpmnElement="Lane_admin" isHorizontal="true"><dc:Bounds x="188" y="100" width="3234" height="145"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_nv_di" bpmnElement="Lane_nv" isHorizontal="t