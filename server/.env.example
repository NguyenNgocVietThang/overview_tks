# Sao chép file này thành .env khi phát triển cục bộ. Không bao giờ commit file .env thật.

# Workbook "Bảng Công nợ" dùng chung, gồm hai tab Công nợ HN/Công nợ SG.
# Server chỉ đọc; chia sẻ quyền Viewer cho service account là đủ.
DEBT_MANAGEMENT_SPREADSHEET_ID=your-debt-management-spreadsheet-id

# Workbook vị trí hàng chung: Vị trí HN / Vị trí SG (chỉ đọc, share Viewer).
STOCK_LOCATIONS_SPREADSHEET_ID=1J5yRJfOjNjzx0akOtog0ro3d5HGPhMTl7LklBWHZPqw

# Báo cáo Marketing: cả ba nguồn chỉ đọc, chia sẻ Viewer cho service account.
MARKETING_REPORT_SPREADSHEET_ID=14MaEMfPCyfxPx-HfJMJ1gcwIpKVbuhx3FIBCSnLSWl8
MARKETING_PHONES_SPREADSHEET_ID=1cAOmY4WC2tIE0-OMwvy43PTR9dNK72k2d4DUDrB2swk
MARKETING_ADS_SPREADSHEET_ID=12b4Y5-zIuVHxgdVHoxtbIirhTYl3Czw0DIGHvaCODzs

# Dán TOÀN BỘ khóa JSON của service account thành một dòng duy nhất (các biến môi trường
# trên Render không hỗ trợ tốt giá trị nhiều dòng, nên hãy giữ trên một dòng/JSON rút gọn).
# Quyền Viewer là đủ cho nguồn Công nợ và Vị trí hàng.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

PORT=3000
KIOTVIET_CLIENT_ID=your_kiotviet_client_id
KIOTVIET_CLIENT_SECRET=your_kiotviet_client_secret
KIOTVIET_RETAILER=your_retailer_name

# Dang nhap/phan quyen (server/auth/). Chuoi bat ky, cang dai/ngau nhien cang
# tot — vd: openssl rand -hex 32. Doi gia tri nay se dang xuat TOAN BO user
# dang dang nhap (moi JWT cu deu mat hieu luc).
JWT_SECRET=change-me-to-a-long-random-string
# Tuy chon — mac dinh 12h. Cu phap theo thu vien "ms" (vd "7d", "30m").
JWT_EXPIRES_IN=12h

# Dang nhap bang Google (tuy chon — bo trong se an nut "Dang nhap bang
# Google" tren trang login). Tao "OAuth 2.0 Client ID" loai "Web application"
# tren Google Cloud Console (APIs & Services > Credentials), Authorized
# JavaScript origin = domain chay dashboard (vd http://localhost:3000). Day
# KHONG phai secret, khong can GOOGLE_CLIENT_SECRET.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ============================================================
# GUI OTP QUEN MAT KHAU — Email (Gmail SMTP)
# Bo trong thi otpService fallback ve console.log (che do dev).
# ============================================================
# Tai khoan Gmail dung de GUI di (khong phai tai khoan nhan). Bat 2FA cho
# tai khoan nay roi tao App Password 16 ky tu tai
# https://myaccount.google.com/apppasswords — dan vao SMTP_APP_PASSWORD,
# KHONG dung mat khau Gmail that.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=TOKOSI Dashboard

# ============================================================
# BOT TELEGRAM RIENG CHO QUAN LY NGHI PHEP (chay cung Express)
# Xem docs/telegram-manager-leave-setup.md. Chay migration 0029 truoc
# khi chay ban web moi, ke ca khi bot tat.
# ============================================================
HR_MANAGER_TELEGRAM_ENABLED=false
# Token bot MOI tu BotFather, khong dung token bot xin nghi cua nhan vien.
# Khong commit token/secret that, khong dan vao chat.
HR_MANAGER_TELEGRAM_BOT_TOKEN=
# Secret dang ky webhook va kiem tra X-Telegram-Bot-Api-Secret-Token.
HR_MANAGER_TELEGRAM_WEBHOOK_SECRET=
# HTTPS origin cong khai, vd https://tokosi.onrender.com (khong co path).
HR_MANAGER_TELEGRAM_WEB_URL=
HR_MANAGER_TELEGRAM_SCAN_INTERVAL_MS=5000
# Cau Postgres -> SSE HR, doc lap voi cong tac bot; mac dinh true.
HR_LEAVE_DB_REALTIME_ENABLED=true

# ============================================================
# CO SO SAI GON (tuy chon — bo trong thi tab tuong ung bao "Chua cau hinh")
# ============================================================
# Gian hang KiotViet cua co so Sai Gon (dung cho "Kiem tra dut hang"). Neu dung
# chung tai khoan KiotViet thi chi can dien KIOTVIET_RETAILER_SG.
KIOTVIET_RETAILER_SG=
KIOTVIET_CLIENT_ID_SG=
KIOTVIET_CLIENT_SECRET_SG=

# ============================================================
# SUPABASE POSTGRES — dong bo KiotViet, xem
# docs/04-planning/2026-09-14-roadmap-supabase-kiotviet-sync.md
# ============================================================
# Chuoi ket noi Supabase Postgres — dung "Direct connection" (cong 5432),
# KHONG dung pooler (cong 6543), vi server chay 1 tien trinh lien tuc.
SUPABASE_DB_URL=
# Tuy chon — mac dinh true khi NODE_ENV=production, nguoc lai false. Supabase
# Postgres can SSL; Postgres local (Docker) thi khong.
PGSSL=false
# Cong tac chinh cua engine dong bo KiotViet->Supabase (webhook + polling).
# Mac dinh TAT — chi dat "true" thu cong khi engine da san sang o Giai doan 2.
KIOTVIET_SYNC_ENABLED=
# Polling reconciliation: mac dinh 7 phut cho invoices/orders, 20 phut cho
# cac entity con lai. Chi co hieu luc khi KIOTVIET_SYNC_ENABLED=true.
KIOTVIET_SYNC_FAST_INTERVAL_MS=
KIOTVIET_SYNC_SLOW_INTERVAL_MS=
# So quy: nhip rieng 60 giay (toi thieu 60 giay). Cong tac rieng cho phep
# chay cashflow + bankaccounts ngay ca khi KIOTVIET_SYNC_ENABLED=false.
# Khi engine tong bat thi So quy cung bat; khong can dat cong tac rieng.
KIOTVIET_CASHBOOK_SYNC_ENABLED=
KIOTVIET_CASHBOOK_SYNC_INTERVAL_MS=60000
# Chu ky toi thieu giua 2 lan quet TOAN BO ton kho (/productOnHands); mac dinh 10 phut.
# Chi chay trong nhom fast nen thuc te khong nho hon KIOTVIET_SYNC_FAST_INTERVAL_MS.
KIOTVIET_SYNC_ONHAND_SNAPSHOT_INTERVAL_MS=

# Bi mat gan vao duong dan webhook KiotViet. Cau hinh ben KiotViet tro toi
# https://<domain>/api/kiotviet/webhook/<secret>. Sinh mot chuoi ngau nhien
# dai (vd `openssl rand -hex 32`); de trong thi duong dan co secret luon 404.
KIOTVIET_WEBHOOK_SECRET=
# Duong dan CU khong co secret (/api/kiotviet/webhook) — mac dinh VAN BAT de
# khong mat su kien trong giai doan chuyen tiep. Sau khi da doi URL ben
# KiotViet sang duong dan co secret, dat "false" de dong han duong dan cu.
KIOTVIET_WEBHOOK_LEGACY_PATH_ENABLED=

# Chuoi ket noi 1 Supabase project TEST rieng biet, TACH HOAN TOAN voi
# SUPABASE_DB_URL production o tren (khong duoc dung chung, khong duoc dat cung
# 1 gia tri) - chi dung boi
# kiotvietSync/integration/fullSync.integration.test.js (Phase 4 Task 3). Bo
# trong thi bo test tich hop nay tu dong skip toan bo, KHONG fallback sang
# SUPABASE_DB_URL. Chi dat bien nay khi chay thu cong, tro toi 1 Supabase
# project rieng da chay `npm run db:migrate` - khong bao gio tro toi project
# dang co du lieu that.
SUPABASE_TEST_DB_URL=
