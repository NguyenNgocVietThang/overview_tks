# Sao chép file này thành .env khi phát triển cục bộ. Không bao giờ commit file .env thật.

# Google Sheet ID của file được đồng bộ bởi Apps Script trong src/. Tác vụ
# sync:customer-report của Node có thể ghi lại hai tab báo cáo. Lấy từ URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your-google-sheet-id

# Workbook "Bảng Công nợ" dùng chung, gồm hai tab Công nợ HN/Công nợ SG.
# Server chỉ đọc; chia sẻ quyền Viewer cho service account là đủ.
DEBT_MANAGEMENT_SPREADSHEET_ID=your-debt-management-spreadsheet-id

# Dán TOÀN BỘ khóa JSON của service account thành một dòng duy nhất (các biến môi trường
# trên Render không hỗ trợ tốt giá trị nhiều dòng, nên hãy giữ trên một dòng/JSON rút gọn).
# Quyền Viewer là đủ cho dashboard; cần Editor nếu chạy sync:customer-report
# HOẶC nếu bật USERS_SHEET_SYNC_ENABLED (xem cuối file) — thiếu Editor thì mọi
# lần ghi tab "Users" sẽ lỗi 403.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

PORT=3000
KIOTVIET_CLIENT_ID=your_kiotviet_client_id
KIOTVIET_CLIENT_SECRET=your_kiotviet_client_secret
KIOTVIET_RETAILER=your_retailer_name

# Dang nhap/phan quyen (server/auth/). Chuoi bat ky, cang dai/ngau nhien cang
# tot — vd: openssl rand -hex 32. Doi gia tri nay se dang xuat TOAN BO user
# dang dang nhap (moi JWT cu deu mat hieu luc).
JWT_SECRET=change-me-to-a-long-random-string
# Tuy chon — mac dinh 12h. Cu phap theo thu vien "ms" (vd "7d", "30m").
JWT_EXPIRES_IN=12h

# Dang nhap bang Google (tuy chon — bo trong se an nut "Dang nhap bang
# Google" tren trang login). Tao "OAuth 2.0 Client ID" loai "Web application"
# tren Google Cloud Console (APIs & Services > Credentials), Authorized
# JavaScript origin = domain chay dashboard (vd http://localhost:3000). Day
# KHONG phai secret, khong can GOOGLE_CLIENT_SECRET.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ============================================================
# GUI OTP QUEN MAT KHAU — Email (Gmail SMTP)
# Bo trong thi otpService fallback ve console.log (che do dev).
# ============================================================
# Tai khoan Gmail dung de GUI di (khong phai tai khoan nhan). Bat 2FA cho
# tai khoan nay roi tao App Password 16 ky tu tai
# https://myaccount.google.com/apppasswords — dan vao SMTP_APP_PASSWORD,
# KHONG dung mat khau Gmail that.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=TOKOSI Dashboard

# ============================================================
# QUAN LY VAN CHUYEN — Phase 1A (bo trong neu chua dung module van chuyen)
# ============================================================

# ID cua Google Spreadsheet RIENG cho van chuyen (tao bang: node scripts/setupVcSheet.js).
# Khac hoan toan voi SPREADSHEET_ID KiotViet o tren.
VC_SPREADSHEET_ID=your-vc-spreadsheet-id

# ID cua thu muc Google Drive luu anh chung tu van chuyen.
# Service account can duoc cap quyen "Editor" len thu muc nay.
# Lay tu URL: https://drive.google.com/drive/folders/<FOLDER_ID>
VC_DRIVE_FOLDER_ID=your-google-drive-folder-id-for-vc-attachments

# ============================================================
# VONG DOI DON HANG — Bot Telegram + Apps Script NGOAI REPO NAY ghi truc tiep
# vao spreadsheet nay (2 tab DonHang_HN/DonHang_SG). Server CHI DOC (Viewer la
# du). Bo trong thi tinh nang tra 503 BRANCH_NOT_CONFIGURED, server van chay.
# ============================================================
ORDER_LIFECYCLE_SPREADSHEET_ID=your-order-lifecycle-spreadsheet-id

# ============================================================
# AI PROXY (xKiro, https://xkiro.com) — nhan dang tin nhan xin nghi bang AI
# ============================================================
# Xem docs/superpowers/specs/2026-08-31-telegram-ai-leave-message-recognition.md
# Tao key tai https://xkiro.com/dashboard/api/keys — KHONG commit gia tri that.
AI_LEAVE_API_KEY=your-xkiro-api-key
AI_LEAVE_API_BASE_URL=https://api.xkiro.com/v1
# Dang "vendor/model". deepseek/deepseek-v4-pro dang thuoc free tier va da
# duoc smoke test voi tin nhan xin nghi tieng Viet. Xem danh sach model/gia tai
# https://xkiro.com/models hoac https://xkiro.com/deals.
AI_LEAVE_API_MODEL=deepseek/deepseek-v4-pro
# Goi song song va dung ket qua ngay khi co 2 model hop le khop nhau.
AI_LEAVE_API_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,qwen/qwen3-max:free,mistralai/mistral-small-2603,mistralai/mistral-medium-3.5
AI_LEAVE_API_TIMEOUT_MS=30000
HR_TIME_ZONE=Asia/Bangkok

# ============================================================
# CO SO SAI GON (tuy chon — bo trong thi tab tuong ung bao "Chua cau hinh")
# ============================================================
# SPREADSHEET_ID o dau file la co so HA NOI. Bien duoi day la spreadsheet bao
# cao cua co so SAI GON (tab giong het Ha Noi, chi khac spreadsheet).
SPREADSHEET_ID_SG=1CggoVtA7OFayhr1IeSHbREcomsMOPYHdQc-PDjWiC5A

# Nguon Van chuyen / Nhan su rieng cua Sai Gon — se cung cap sau. Bo trong thi
# hai tab do o co so Sai Gon tra 503 BRANCH_NOT_CONFIGURED (server van chay).
VC_SPREADSHEET_ID_SG=
VC_DRIVE_FOLDER_ID_SG=
HR_SPREADSHEET_ID_SG=

# Gian hang KiotViet cua co so Sai Gon (dung cho "Kiem tra dut hang"). Neu dung
# chung tai khoan KiotViet thi chi can dien KIOTVIET_RETAILER_SG.
KIOTVIET_RETAILER_SG=
KIOTVIET_CLIENT_ID_SG=
KIOTVIET_CLIENT_SECRET_SG=

# ============================================================
# SUPABASE POSTGRES — dong bo KiotViet, xem
# docs/04-planning/2026-09-14-roadmap-supabase-kiotviet-sync.md
# ============================================================
# Chuoi ket noi Supabase Postgres — dung "Direct connection" (cong 5432),
# KHONG dung pooler (cong 6543), vi server chay 1 tien trinh lien tuc.
SUPABASE_DB_URL=
# Tuy chon — mac dinh true khi NODE_ENV=production, nguoc lai false. Supabase
# Postgres can SSL; Postgres local (Docker) thi khong.
PGSSL=false
# Cong tac chinh cua engine dong bo KiotViet->Supabase (webhook + polling).
# Mac dinh TAT — chi dat "true" thu cong khi engine da san sang o Giai doan 2.
KIOTVIET_SYNC_ENABLED=
# Polling reconciliation: mac dinh 7 phut cho invoices/orders, 20 phut cho
# cac entity con lai. Chi co hieu luc khi KIOTVIET_SYNC_ENABLED=true.
KIOTVIET_SYNC_FAST_INTERVAL_MS=
KIOTVIET_SYNC_SLOW_INTERVAL_MS=
# Shared-secret tu chon (KHONG phai do KiotViet cap) de xac thuc endpoint
# nhan webhook — gan vao query string luc dang ky (kiotvietSync/
# registerWebhooks.js --execute), doi chieu lai trong kiotvietWebhookRoutes.js.
# Rieng biet voi WEBHOOK_SECRET cua Apps Script/Google Sheets cu (khong dung
# chung). Sinh bang: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
KIOTVIET_WEBHOOK_SECRET=
# So ngay giu lai ban ghi tho trong webhook_events_raw truoc khi tu dong xoa
# (chi la log tho de doi chieu/debug, du lieu nghiep vu that da nam trong
# orders/invoices/... roi). Tuy chon - mac dinh 30 ngay. Quan trong voi
# Supabase free tier (500MB) vi bang nay tang vo han neu khong don.
KIOTVIET_WEBHOOK_EVENTS_RETENTION_DAYS=

# Chuoi ket noi 1 Supabase project TEST rieng biet, TACH HOAN TOAN voi
# SUPABASE_DB_URL production o tren (khong duoc dung chung, khong duoc dat cung
# 1 gia tri) - chi dung boi
# kiotvietSync/integration/fullSync.integration.test.js (Phase 4 Task 3). Bo
# trong thi bo test tich hop nay tu dong skip toan bo, KHONG fallback sang
# SUPABASE_DB_URL. Chi dat bien nay khi chay thu cong, tro toi 1 Supabase
# project rieng da chay `npm run db:migrate` - khong bao gio tro toi project
# dang co du lieu that.
SUPABASE_TEST_DB_URL=

# ============================================================
# DONG BO TAI KHOAN/PHAN QUYEN <-> GOOGLE SHEETS (tab "Users" trong
# spreadsheet KiotViet o dau file, xem server/auth/localUserStore.js)
# ============================================================
# Dia cuc bo tren Render la ephemeral — mat het moi khi container restart.
# Bat co nay de dong bo hai chieu voi tab "Users": nap lai luc khoi dong +
# day thay doi (tao/sua/xoa tai khoan) len Sheets ngay lap tuc.
# Mac dinh: tu bat khi RENDER=true, tat o local/test (tranh ghi nham vao
# spreadsheet that trong luc npm test — server/auth/localUserStore.test.js
# mock rieng, khong can bien nay). Yeu cau: tab "Users" da ton tai (chay
# `npm run setup:users-sheet -- --init` 1 lan neu chua co) VA spreadsheet
# duoc share quyen Editor cho service account (xem GOOGLE_SERVICE_ACCOUNT_JSON).
USERS_SHEET_SYNC_ENABLED=

# ============================================================
# DONG BO HOI THOAI XIN NGHI PHEP (bot Telegram) <-> GOOGLE SHEETS
# (tab an "_HR_TELEGRAM_SESSIONS" trong spreadsheet nhan su, xem
# server/telegram/conversationStore.js)
# ============================================================
# Dia cuc bo tren Render la ephemeral — mat het moi khi container
# restart/redeploy. Neu dieu do roi dung luc nhan vien dang xin nghi phep do
# dang, hoi thoai bi mat va bot xu ly tin nhan tiep theo nhu mo dau moi (vd:
# hoi lai danh tinh giua chung tra loi Ly do/Ban giao). Bat co nay de bot ghi
# ban sao moi hoi thoai len Sheet va khoi phuc lai luc khoi dong.
# Mac dinh: tu bat khi RENDER=true, tat o local/test (tranh ghi nham vao
# spreadsheet that trong luc npm test). Tab se tu duoc tao neu chua co, chi
# can spreadsheet HR_SPREADSHEET_ID duoc share quyen Editor cho service account.
TELEGRAM_SESSION_SHEET_SYNC_ENABLED=
