# Sao chép file này thành .env khi phát triển cục bộ. Không bao giờ commit file .env thật.

# Google Sheet ID của file được đồng bộ bởi Apps Script trong src/. Tác vụ
# sync:customer-report của Node có thể ghi lại hai tab báo cáo. Lấy từ URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your-google-sheet-id

# Dán TOÀN BỘ khóa JSON của service account thành một dòng duy nhất (các biến môi trường
# trên Render không hỗ trợ tốt giá trị nhiều dòng, nên hãy giữ trên một dòng/JSON rút gọn).
# Quyền Viewer là đủ cho dashboard; cần Editor nếu chạy sync:customer-report.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

PORT=3000
KIOTVIET_CLIENT_ID=your_kiotviet_client_id
KIOTVIET_CLIENT_SECRET=your_kiotviet_client_secret
KIOTVIET_RETAILER=your_retailer_name

# Dang nhap/phan quyen (server/auth/). Chuoi bat ky, cang dai/ngau nhien cang
# tot — vd: openssl rand -hex 32. Doi gia tri nay se dang xuat TOAN BO user
# dang dang nhap (moi JWT cu deu mat hieu luc).
JWT_SECRET=change-me-to-a-long-random-string
# Tuy chon — mac dinh 12h. Cu phap theo thu vien "ms" (vd "7d", "30m").
JWT_EXPIRES_IN=12h

# Dang nhap bang Google (tuy chon — bo trong se an nut "Dang nhap bang
# Google" tren trang login). Tao "OAuth 2.0 Client ID" loai "Web application"
# tren Google Cloud Console (APIs & Services > Credentials), Authorized
# JavaScript origin = domain chay dashboard (vd http://localhost:3000). Day
# KHONG phai secret, khong can GOOGLE_CLIENT_SECRET.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ============================================================
# GUI OTP QUEN MAT KHAU — Email (Gmail SMTP) + SMS (SpeedSMS)
# Bo trong ca hai thi otpService fallback ve console.log (che do dev).
# ============================================================
# Tai khoan Gmail dung de GUI di (khong phai tai khoan nhan). Bat 2FA cho
# tai khoan nay roi tao App Password 16 ky tu tai
# https://myaccount.google.com/apppasswords — dan vao SMTP_APP_PASSWORD,
# KHONG dung mat khau Gmail that.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=TOKOSI Dashboard

# SpeedSMS (speedsms.vn) — Access Token lay trong trang "Thong tin tai khoan"
# sau khi dang ky. SPEEDSMS_SENDER tuy chon (brandname da dang ky).
SPEEDSMS_ACCESS_TOKEN=your-speedsms-access-token
SPEEDSMS_SENDER=

# ============================================================
# QUAN LY VAN CHUYEN — Phase 1A (bo trong neu chua dung module van chuyen)
# ============================================================

# ID cua Google Spreadsheet RIENG cho van chuyen (tao bang: node scripts/setupVcSheet.js).
# Khac hoan toan voi SPREADSHEET_ID KiotViet o tren.
VC_SPREADSHEET_ID=your-vc-spreadsheet-id

# ID cua thu muc Google Drive luu anh chung tu van chuyen.
# Service account can duoc cap quyen "Editor" len thu muc nay.
# Lay tu URL: https://drive.google.com/drive/folders/<FOLDER_ID>
VC_DRIVE_FOLDER_ID=your-google-drive-folder-id-for-vc-attachments

# ============================================================
# CO SO SAI GON (tuy chon — bo trong thi tab tuong ung bao "Chua cau hinh")
# ============================================================
# SPREADSHEET_ID o dau file la co so HA NOI. Bien duoi day la spreadsheet bao
# cao cua co so SAI GON (tab giong het Ha Noi, chi khac spreadsheet).
SPREADSHEET_ID_SG=1CggoVtA7OFayhr1IeSHbREcomsMOPYHdQc-PDjWiC5A

# Nguon Van chuyen / Nhan su rieng cua Sai Gon — se cung cap sau. Bo trong thi
# hai tab do o co so Sai Gon tra 503 BRANCH_NOT_CONFIGURED (server van chay).
VC_SPREADSHEET_ID_SG=
VC_DRIVE_FOLDER_ID_SG=
HR_SPREADSHEET_ID_SG=

# Gian hang KiotViet cua co so Sai Gon (dung cho "Kiem tra dut hang"). Neu dung
# chung tai khoan KiotViet thi chi can dien KIOTVIET_RETAILER_SG.
KIOTVIET_RETAILER_SG=
KIOTVIET_CLIENT_ID_SG=
KIOTVIET_CLIENT_SECRET_SG=
