# Copy this file to .env for local development. Never commit the real .env.

# Google Sheet ID cua file duoc dong bo boi Apps Script trong src/. Tac vu
# sync:customer-report cua Node co the ghi lai hai tab bao cao. Lay tu URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your-google-sheet-id

# Paste the ENTIRE service account JSON key as a single line (Render env vars
# don't support multi-line values well, so keep it on one line/minified JSON).
# Viewer la du cho dashboard; can Editor neu chay sync:customer-report.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

PORT=3000
KIOTVIET_CLIENT_ID=your_kiotviet_client_id
KIOTVIET_CLIENT_SECRET=your_kiotviet_client_secret
KIOTVIET_RETAILER=your_retailer_name
