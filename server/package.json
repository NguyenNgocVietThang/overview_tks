{
  "name": "tokosi-dashboard-server",
  "version": "1.0.0",
  "private": true,
  "description": "Node/Express backend for TOKOSI, reading separate Dashboard, Shipment and HR Google Sheets.",
  "main": "index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node -e \"console.log('Express app: no build step required')\"",
    "start": "node --max-old-space-size=512 index.js",
    "dev": "node --max-old-space-size=1024 index.js",
    "test": "node --test",
    "sync:customer-report": "node jobs/syncCustomerReport.js",
    "setup:users-sheet": "node scripts/setupUsersSheet.js",
    "setup:vc-sheet": "node scripts/setupVcSheet.js",
    "setup:hr-sheet": "node scripts/setupHrSheet.js",
    "migrate:user-branches": "node scripts/migrateUserBranches.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "google-auth-library": "^9.15.1",
    "googleapis": "^140.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "jsdom": "^30.0.1"
  }
}
